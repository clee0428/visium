summary_df <- bind_rows(summary_all)

summary_df$n_bins_after_strict_mask <- nrow(df_plot)
summary_df$pct_bins_retained_after_strict_mask <- round(nrow(df_plot) / nrow(df) * 100, 2)
summary_df$strict_signal_cut_q25 <- signal_cut
summary_df$strict_umi_cut_q20 <- umi_cut_strict
summary_df$strict_feature_cut_q20 <- feature_cut_strict

summary_df$tumour_score_mean_after_mask <- mean(df_plot$Tumour_mean_expr, na.rm = TRUE)
summary_df$tcell_score_mean_after_mask <- mean(df_plot$Tcell_mean_expr, na.rm = TRUE)
summary_df$caf_score_mean_after_mask <- mean(df_plot$CAF_mean_expr, na.rm = TRUE)

